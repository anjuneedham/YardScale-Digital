# Newsletter (Netlify Function → Resend). Copy to .env for `netlify dev`.
# In production these go in Netlify → Site configuration → Environment variables
# (Production + Preview + Development). NEVER commit real values.

# Required — from https://resend.com/api-keys. Secret, server-side only.
RESEND_API_KEY=

# Required — from https://resend.com/audiences. The list subscribers join.
RESEND_AUDIENCE_ID=

# Optional — welcome email From address. Must be on a domain verified in Resend.
# Leave empty until the domain exists: signups still work, no welcome is sent.
# NEWSLETTER_FROM=YardScale Digital <updates@yourdomain.com>

# Optional — gets a one-line heads-up per subscriber. Needs NEWSLETTER_FROM.
# NEWSLETTER_NOTIFY_TO=
